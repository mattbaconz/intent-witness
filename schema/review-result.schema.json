{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "0.1"
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_NOTES",
        "REVISE",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "deepestProblem": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "polish",
            "composition",
            "information_architecture",
            "interaction"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "productMismatch": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "screenshot"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "region": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "fact": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "path"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "dom"
                    },
                    "selector": {
                      "type": "string"
                    },
                    "fact": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "fact"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "source"
                    },
                    "file": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "number"
                    },
                    "fact": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "file",
                    "fact"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "interaction"
                    },
                    "route": {
                      "type": "string",
                      "minLength": 1
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "fact": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "route",
                    "steps",
                    "fact"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "responsive"
                    },
                    "viewport": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fact": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "viewport",
                    "fact"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "design-memory"
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fact": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "source",
                    "fact"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "depth": {
            "type": "string",
            "enum": [
              "polish",
              "composition",
              "information_architecture",
              "interaction"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "non_blocking",
              "material"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "revisionConstraint": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "observation",
          "productMismatch",
          "evidence",
          "depth",
          "severity",
          "confidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "severity": {
                  "const": "material"
                }
              },
              "required": [
                "severity"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "alternativesRequired": {
      "type": "boolean"
    },
    "alternativeConstraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "overallConfidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidenceRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "request",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocolVersion",
    "schemaVersion",
    "verdict",
    "summary",
    "findings",
    "alternativesRequired",
    "overallConfidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "REVISE"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "severity": {
                  "const": "material"
                }
              },
              "required": [
                "severity"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "PASS",
              "PASS_WITH_NOTES"
            ]
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "properties": {
                  "severity": {
                    "const": "material"
                  }
                },
                "required": [
                  "severity"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "alternativesRequired": {
            "const": true
          }
        },
        "required": [
          "alternativesRequired"
        ]
      },
      "then": {
        "required": [
          "alternativeConstraints"
        ],
        "properties": {
          "deepestProblem": {
            "enum": [
              "information_architecture",
              "interaction"
            ]
          },
          "alternativeConstraints": {
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
